<h1>Créer un nouvel Article :</h1>

<%= form_with scope: :article, url:articles_path, local: true do |f| %>

  <p>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :description %><br>
    <%= f.textarea :description %>
  </p>

  <p>
    <%= f.submit %>
  </p>
<% end %>
