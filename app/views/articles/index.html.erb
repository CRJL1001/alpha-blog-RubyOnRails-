<h1>Liste des articles</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @articles.each do |article| %>
    <tr>
      <td><%= article.title %></td>
      <td><%= article.description %></td>
      <td>
        <%= form_with url: article_path(article), method: :get do |f| %>
          <%= f.submit "Voir" %>
        <% end %>
      </td>
      <td>
        <%= form_with url: article_path(article), method: :delete do |f| %>
          <%= f.submit "Supprimer" %>
        <% end %>
      </td>

    </tr>
    <% end %>
  </tbody>
</table>
