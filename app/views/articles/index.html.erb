<h1>Liste des articles</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @articles.each do |article| %>
    <tr>
      <td><%= article.title %></td>
      <td><%= article.description %></td>
      <td>
        <%= link_to "Voir", article_path(article), data: {"turbo-method": :get} %>
      </td>
      <td><%= link_to 'Edit', edit_article_path(article) %></td>
      <td>
        <%= link_to "Supprimer", article_path(article), data: {"turbo-method": :delete ,"turbo-confirm": "Êtes-vous sûr ?"} %>
      </td>

    </tr>
    <% end %>
  </tbody>
</table>
<p>
  <%= link_to 'Créer un nouvel article', new_article_path %>
</p>

<%= link_to 'page d\'accueil', root_path %>
